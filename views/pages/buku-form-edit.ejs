<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container" style="padding: 20px; max-width: 600px; margin: auto;">
        <h1><%= pageTitle %></h1>
        <form action="/buku/edit/<%= buku.id %>" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
            <div style="margin-bottom: 10px;">
                <label for="judul" style="display: block; margin-bottom: 5px;">Judul Buku:</label>
                <input type="text" id="judul" name="judul" value="<%= buku.judul %>" required style="width: 100%; padding: 8px;">
            </div>

            <div style="margin-bottom: 10px;">
                <label for="penulis" style="display: block; margin-bottom: 5px;">Penulis:</label>
                <input type="text" id="penulis" name="penulis" value="<%= buku.penulis %>" required style="width: 100%; padding: 8px;">
            </div>

            <div style="margin-bottom: 10px;">
                <label for="kategori" style="display: block; margin-bottom: 5px;">Kategori:</label>
                <select id="kategori" name="kategori" required style="width: 100%; padding: 8px;">
                    <option value="">-- Pilih Kategori --</option>
                    <option value="Novel" <%= buku.kategori === 'Novel' ? 'selected' : '' %>>Novel</option>
                    <option value="Sains" <%= buku.kategori === 'Sains' ? 'selected' : '' %>>Sains</option>
                    <option value="Teknologi" <%= buku.kategori === 'Teknologi' ? 'selected' : '' %>>Teknologi</option>
                    <option value="Sejarah" <%= buku.Kategori === 'Sejarah' ? 'selected' : '' %>>Sejarah</option>
                    <option value="Lainnya" <%= buku.kategori === 'Lainnya' ? 'selected' : '' %>>Lainnya</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label for="harga_denda" style="display: block; margin-bottom: 5px;">Harga Denda (per hari):</label>
                <input type="number" step="0.01" id="harga_denda" name="harga_denda" value="<%= buku.harga_denda %>" required style="width: 100%; padding: 8px;">
            </div>

            <div style="margin-bottom: 10px;">
                <label for="stok" style="display: block; margin-bottom: 5px;">Stok:</label>
                <input type="number" id="stok" name="stok" value="<%= buku.stok %>" required style="width: 100%; padding: 8px;">
            </div>

            <div style="margin-bottom: 15px;">
                <label for="tanggal_masuk" style="display: block; margin-bottom: 5px;">Tanggal Masuk:</label>
                <input type="date" id="tanggal_masuk" name="tanggal_masuk" value="<%= buku.tanggal_masuk ? buku.tanggal_masuk.toISOString().split('T')[0] : '' %>" required style="width: 100%; padding: 8px;">
            </div>

            <div>
                <button type="submit" style="padding: 10px 15px; background-color: #007bff; color: white; border: none; cursor: pointer;">Perbarui Buku</button>
                <a href="/buku" style="margin-left: 10px; text-decoration: none; color: #666;">Batal</a>
            </div>
        </form>
    </div>
</body>
</html>